# Repo-root environment for docker-compose (copy to `.env`; never commit `.env`).
# This file drives the supporting services AND documents the connection strings
# the backend will use to reach them. (App settings themselves live in
# backend/.env.example with the SOURCEBOUND_ prefix.)

# =============================================================================
# PostgreSQL — application metadata store
# =============================================================================
POSTGRES_USER=sourcebound
POSTGRES_PASSWORD=sourcebound
POSTGRES_DB=sourcebound
POSTGRES_PORT=5432
# Backend connects with the async driver:
# DATABASE_URL=postgresql+asyncpg://sourcebound:sourcebound@localhost:5432/sourcebound

# =============================================================================
# Qdrant — vector store (6333 = HTTP + dashboard, 6334 = gRPC)
# =============================================================================
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_URL=http://localhost:6333

# =============================================================================
# Redis — cache + Celery broker
# =============================================================================
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Vertex AI auth (api + worker) — only needed when LLM/EMBEDDING_PROVIDER=vertex
# =============================================================================
# Local dev (default): your gcloud ADC is mounted to the well-known path and used
# automatically — leave all three unset and run `gcloud auth application-default login`.
#
# Production: use a dedicated service-account key instead of personal ADC —
# mount the key FILE and point the SDK at it:
#   GCLOUD_CREDS_HOST=/etc/secrets/sourcebound-sa.json   # host path to the SA key file
#   GCLOUD_CREDS_TARGET=/var/secrets/gcp-sa.json         # in-container path
#   GOOGLE_APPLICATION_CREDENTIALS=/var/secrets/gcp-sa.json
# (Grant the SA least privilege: roles/aiplatform.user.)

# =============================================================================
# Langfuse — observability UI/API (host 3001; container listens on 3000)
# =============================================================================
LANGFUSE_PORT=3001
LANGFUSE_TELEMETRY_ENABLED=false
# Secrets — generate real values: `openssl rand -hex 32`
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth-secret
LANGFUSE_SALT=change-me-salt

# Langfuse's own Postgres (internal to compose; not exposed on the host)
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_DB_NAME=langfuse
# API keys are created in the Langfuse UI after first login, then set in the backend:
# LANGFUSE_HOST=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
