# Copy to `.env` and adjust. Never commit the real `.env`.

# --- Application ---
SOURCEBOUND_APP_NAME=Sourcebound
SOURCEBOUND_APP_VERSION=0.1.0
SOURCEBOUND_ENVIRONMENT=local          # local | development | staging | production
SOURCEBOUND_DEBUG=false

# --- API ---
SOURCEBOUND_API_V1_PREFIX=/api/v1

# --- CORS (comma-separated origins) ---
SOURCEBOUND_CORS_ORIGINS=http://localhost:3000

# --- Logging ---
SOURCEBOUND_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
SOURCEBOUND_LOG_JSON=true              # true for JSON logs, false for colorized console

# --- Retrieval (hybrid dense + BM25 sparse, fused with weighted RRF) ---
SOURCEBOUND_RETRIEVER_MODE=hybrid      # hybrid | dense | sparse
SOURCEBOUND_HYBRID_DENSE_WEIGHT=1.0    # weight on semantic (dense) ranking
SOURCEBOUND_HYBRID_SPARSE_WEIGHT=1.0   # weight on lexical (BM25) ranking
# SOURCEBOUND_HYBRID_RRF_K=60          # RRF rank constant
# SOURCEBOUND_HYBRID_PREFETCH_LIMIT=20 # candidates per retriever before fusion

# --- Langfuse observability (standard LANGFUSE_* names, NOT SOURCEBOUND_-prefixed) ---
# Get keys from Langfuse UI -> Settings -> API Keys. Tracing no-ops if unset.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # US: https://us.cloud.langfuse.com
# LANGFUSE_RELEASE=                              # optional: git sha / version tag

# --- LLM provider (pick one) ---
LLM_PROVIDER=ollama          # ollama | groq | gemini | openai | vertex
# LLM_MODEL=                 # optional; defaults per provider
# ollama (local, free): run `ollama serve` and pull a model, no key needed
# groq free tier:   LLM_PROVIDER=groq   GROQ_API_KEY=gsk_...
# gemini dev API:   LLM_PROVIDER=gemini GOOGLE_API_KEY=AIza...   (separate AI Studio billing)
# vertex (Gemini, COVERED by GCP promo credits): LLM_PROVIDER=vertex + gcloud ADC, then:
# VERTEX_PROJECT_ID=your-gcp-project
# VERTEX_REGION=us-east5
# LLM_MODEL=gemini-2.5-flash   # fast (~1-2s); or gemini-2.5-pro for accuracy (~8s, thinking)
# NOTE: Claude on Vertex is a Marketplace product — NOT covered by promo credits
#       (real billing). Stick to first-party Gemini to use credits.
